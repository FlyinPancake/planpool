# Config configuration

# Bearer token required for uploads and deletes; min 16 chars, generate with `openssl rand -hex 32` (example: f3a9…64-hex-chars…c1)
PLANPOOL_TOKEN=

# Listen address (default: 0.0.0.0:8080)
# PLANPOOL_ADDR=0.0.0.0:8080

# Directory where plan files are stored (default: ./plans)
# PLANPOOL_DATA_DIR=./plans

# TTL applied when the upload doesn't specify one; humantime format, e.g. "12h", "7days" (default: 7days)
# PLANPOOL_DEFAULT_TTL=7days

# Requested TTLs are clamped to this; humantime format (default: 30days)
# PLANPOOL_MAX_TTL=30days

# Upload size limit; plain bytes or human-readable sizes like "5MB", "512KiB" (default: 5242880, example: 5MB)
# PLANPOOL_MAX_BODY_BYTES=5242880

# Base URL used in returned plan links; falls back to the request's Host header when unset (example: https://plans.example.com)
# PLANPOOL_PUBLIC_URL=
